mail.tim-regener.com {
    handle /api/* {
        reverse_proxy localhost:3001
    }

    handle /auth/* {
        reverse_proxy localhost:54321
    }

    handle /rest/* {
        reverse_proxy localhost:54321
    }

    handle /realtime/* {
        reverse_proxy localhost:54321
    }

    handle /storage/* {
        reverse_proxy localhost:54321
    }

    handle {
        root * /var/www/teammail-frontend
        try_files {path} {path}.html /index.html
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}
