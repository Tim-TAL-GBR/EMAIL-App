# ============================================================
# TeamMail - Umgebungsvariablen für den VPS
# Kopiere diese Datei zu .env und trage deine echten Werte ein.
# WICHTIG: .env niemals in Git committen!
# ============================================================

# --- Supabase (https://app.supabase.com) ---
# Zu finden unter: Project Settings > API
SUPABASE_URL=https://DEINE-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=DEIN-SERVICE-ROLE-KEY

# Diese Werte sind öffentlich und werden ins Frontend gebaut:
EXPO_PUBLIC_SUPABASE_URL=https://DEINE-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-PUBLIC-KEY

# --- Sentry (optional, https://sentry.io) ---
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# --- Redis (intern, normalerweise nicht ändern) ---
REDIS_HOST=redis
REDIS_PORT=6379
